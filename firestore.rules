rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    function isDevAdminAuth() {
      return signedIn()
        && request.auth.token.keys().hasAny(['email'])
        && request.auth.token.email == 'badura_admin@tarnobrzeg112.local';
    }

    function isActive() {
      return isDevAdminAuth()
        || (hasProfile() && me().accountStatus == 'active');
    }

    function isAdmin() {
      return isDevAdminAuth()
        || (isActive() && me().role == 'admin');
    }

    function isModerator() {
      return isAdmin() || (isActive() && me().role == 'moderator');
    }

    function moderatorCan(key) {
      return isAdmin()
        || (isModerator()
          && me().moderatorPermissions is map
          && me().moderatorPermissions[key] == true);
    }

    function canWrite() {
      return isDevAdminAuth()
        || (isActive()
          && me().blockedWrite != true
          && me().muted != true
          && (!('mutedUntil' in me())
            || me().mutedUntil == null
            || me().mutedUntil < request.time));
    }

    function hasMissingFullName() {
      return !resource.data.keys().hasAll(['firstName', 'lastName'])
        || resource.data.firstName == ''
        || resource.data.lastName == '';
    }

    function unitChatEligible() {
      return hasProfile()
        && me().unitType in ['osp', 'psp', 'policja', 'zrm']
        && me().unitName is string
        && me().unitName != '';
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function serviceSessionPath(uid) {
      return /databases/$(database)/documents/service_sessions/$(uid);
    }

    function isServicePreview() {
      return signedIn()
        && request.auth.token.keys().hasAny(['email'])
        && request.auth.token.email == 'badura_admin@tarnobrzeg112.local'
        && exists(serviceSessionPath(request.auth.uid))
        && get(serviceSessionPath(request.auth.uid)).data.active == true
        && get(serviceSessionPath(request.auth.uid)).data.expiresAt > request.time;
    }

    function chatExists(chatId) {
      return exists(chatPath(chatId));
    }

    function chatExistsForWrite(chatId) {
      return exists(chatPath(chatId)) || existsAfter(chatPath(chatId));
    }

    function chatData(chatId) {
      return get(chatPath(chatId)).data;
    }

    function chatDataForWrite(chatId) {
      return existsAfter(chatPath(chatId))
        ? getAfter(chatPath(chatId)).data
        : get(chatPath(chatId)).data;
    }

    function chatType(data) {
      return data.type == null ? data.chatKind : data.type;
    }

    function participants(data) {
      return data.participants is list
        ? data.participants
        : (data.participantIds is list ? data.participantIds : []);
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in participants(data);
    }

    function isPrivateChatIdForAuth(chatId) {
      return signedIn()
        && chatId.matches('^private_.*' + request.auth.uid + '.*$');
    }

    function canAccessChat(chatId, data) {
      return canAccessChatData(data)
        || (isActive()
          && chatType(data) == 'private'
          && isPrivateChatIdForAuth(chatId));
    }

    function isServicePreviewUnitChat(chatId) {
      return isServicePreview()
        && chatExists(chatId)
        && chatType(chatData(chatId)) == 'unit';
    }

    function sameUnit(data) {
      return unitChatEligible()
        && (
          (data.unitId != null && data.unitId == me().unitId)
          || (data.unitName != null && data.unitName == me().unitName)
        );
    }

    function serviceChannelAccess(data) {
      return hasProfile()
        && chatType(data) == 'unit'
        && data.unitId in [
          'service_psp',
          'service_policja',
          'service_medycy',
          'service_media',
          'service-psp',
          'service-policja',
          'service-medycy',
          'service-media'
        ]
        && (
          isAdmin()
          || (data.unitId in ['service_psp', 'service-psp'] && moderatorCan('channelPsp'))
          || (data.unitId in ['service_policja', 'service-policja'] && moderatorCan('channelPolicja'))
          || (data.unitId in ['service_media', 'service-media'] && moderatorCan('channelMedia'))
          || (data.unitId in ['service_medycy', 'service-medycy'] && moderatorCan('channelMedycy'))
          || (me().role != 'moderator' && data.unitId in ['service_psp', 'service-psp'] && me().unitType == 'psp')
          || (me().role != 'moderator' && data.unitId in ['service_policja', 'service-policja'] && me().unitType == 'policja')
          || (me().role != 'moderator' && data.unitId in ['service_media', 'service-media'] && me().unitType == 'media')
          || (me().role != 'moderator' && data.unitId in ['service_medycy', 'service-medycy']
            && me().unitType in ['zrm', 'ratownikMedyczny', 'kierowcaKaretki', 'dyspozytor'])
        );
    }

    function explicitChatAccess(data) {
      return hasProfile()
        && (
          (me().visibleChatIds is list && data.id in me().visibleChatIds)
          || (me().visibleUnitIds is list && data.unitId in me().visibleUnitIds)
        );
    }

    function canAccessChatData(data) {
      return (isServicePreview() && chatType(data) == 'unit')
        || (isActive()
          && (
            chatType(data) == 'main'
            || (chatType(data) == 'unit' && (sameUnit(data) || serviceChannelAccess(data) || explicitChatAccess(data)))
            || isParticipant(data)
            || explicitChatAccess(data)
          ));
    }

    function canReadMessagesInChat(chatId) {
      return (isServicePreview()
          && chatExists(chatId)
          && chatType(chatData(chatId)) == 'unit')
        || (chatExists(chatId) && canAccessChat(chatId, chatData(chatId)))
        || (isActive()
          && (
            chatId == 'main'
            || (unitChatEligible()
              && me().unitId is string
              && chatId == 'unit_' + me().unitId)
          ));
    }

    function canCreateChat() {
      return canWrite()
        && (
          chatType(request.resource.data) == 'main'
          || (chatType(request.resource.data) == 'unit'
            && (sameUnit(request.resource.data) || serviceChannelAccess(request.resource.data)))
          || ((chatType(request.resource.data) in ['private', 'group'])
            && request.auth.uid in participants(request.resource.data))
        );
    }

    function chatMessageMetadataKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt',
        'lastMessage',
        'lastMessageAt',
        'unreadCount',
        'deliveredReceipts',
        'readReceipts',
        'lastReadMessageId',
        'deliveredReceipts.' + request.auth.uid,
        'readReceipts.' + request.auth.uid,
        'lastReadMessageId.' + request.auth.uid,
        'unreadCount.' + request.auth.uid,
        'typing',
        'hiddenFor'
      ]);
    }

    function chatSettingsKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'themeColor',
        'messageStyle',
        'chatTheme',
        'backgroundType',
        'backgroundImageUrl',
        'backgroundPreset',
        'incomingSound',
        'privateSound',
        'mentionSound',
        'sendSound',
        'adminAlertSound',
        'vibrationEnabled',
        'notificationMode',
        'updatedAt'
      ]);
    }

    function chatReadKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'readReceipts',
        'deliveredReceipts',
        'lastReadMessageId',
        'unreadCount',
        'deliveredReceipts.' + request.auth.uid,
        'readReceipts.' + request.auth.uid,
        'lastReadMessageId.' + request.auth.uid,
        'unreadCount.' + request.auth.uid,
        'updatedAt'
      ]);
    }

    function groupParticipantKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'participants',
        'participantIds',
        'participantLogins',
        'participantNames',
        'participantNameMap',
        'unreadCount',
        'typing',
        'joinedAt',
        'hiddenFor',
        'updatedAt'
      ]);
    }

    function privateChatParticipantKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'participants',
        'participantIds',
        'participantLogins',
        'participantNames',
        'participantNameMap',
        'unreadCount',
        'typing',
        'joinedAt',
        'hiddenFor',
        'visibilityMode',
        'expiresAt',
        'updatedAt'
      ]);
    }

    function selfChatVisibilityKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'hiddenFor',
        'clearedAt',
        'joinedAt',
        'updatedAt'
      ]);
    }

    function canUpdateGroupMembers() {
      return isActive()
        && chatType(resource.data) == 'group'
        && groupParticipantKeysOnly()
        && (
          isAdmin()
          || resource.data.createdBy == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || moderatorCan('manageChatMembers')
          || (
            request.auth.uid in participants(resource.data)
            && !(request.auth.uid in participants(request.resource.data))
          )
        );
    }

    function canUpdateChatSettings() {
      return (isActive()
          && resource.data.createdBy == request.auth.uid
          && chatSettingsKeysOnly());
    }

    function canUpdatePrivateChatMembersOrVisibility() {
      return isActive()
        && chatType(resource.data) == 'private'
        && (
          request.auth.uid in participants(resource.data)
          || (resource.data.id is string
            && isPrivateChatIdForAuth(resource.data.id)
            && request.auth.uid in participants(request.resource.data))
        )
        && privateChatParticipantKeysOnly();
    }

    function canUpdateOwnChatVisibility() {
      return isActive()
        && request.auth.uid in participants(resource.data)
        && selfChatVisibilityKeysOnly();
    }

    function canArchiveGroup() {
      return isActive()
        && chatType(resource.data) == 'group'
        && (isAdmin() || resource.data.createdBy == request.auth.uid)
        && request.resource.data.isArchived == true;
    }

    function canDeleteGroupMessage(chatId) {
      return chatExists(chatId)
        && chatType(chatData(chatId)) == 'group'
        && (isAdmin() || chatData(chatId).createdBy == request.auth.uid);
    }

    function isOwnMessageRecall() {
      return canWrite()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.isDeleted == true
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'deleted',
          'deletedAt',
          'deletedBy',
          'deletedByName',
          'originalMessage',
          'originalTextForAdmin',
          'originalAttachmentsForAdmin',
          'text',
          'imageUrl',
          'fileUrl',
          'fileName',
          'attachments'
        ]);
    }

    function isModeratorRecall() {
      return moderatorCan('recallMessages')
        && request.resource.data.isDeleted == true
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'deleted',
          'deletedAt',
          'deletedBy',
          'deletedByName',
          'originalMessage',
          'originalTextForAdmin',
          'originalAttachmentsForAdmin',
          'text',
          'imageUrl',
          'fileUrl',
          'fileName',
          'attachments'
        ]);
    }

    function isOwnMessageEdit() {
      return canWrite()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.isDeleted != true
        && request.resource.data.deleted != true
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'editedAt',
          'editHistory'
        ]);
    }

    function isReactionOrReportUpdate() {
      return isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions',
          'reportCount'
        ]);
    }

    function validMessageCreate(chatId) {
      return canWrite()
        && chatExistsForWrite(chatId)
        && !isServicePreviewUnitChat(chatId)
        && canAccessChat(chatId, chatDataForWrite(chatId))
        && request.resource.data.chatId == chatId
        && (
          request.resource.data.senderId == request.auth.uid
          || (
            request.resource.data.senderId == 'system'
            && (chatType(chatDataForWrite(chatId)) in ['group', 'private'])
            && (
              isAdmin()
              || chatDataForWrite(chatId).createdBy == request.auth.uid
              || chatDataForWrite(chatId).ownerId == request.auth.uid
              || moderatorCan('manageChatMembers')
            )
          )
        )
        && request.resource.data.isDeleted != true
        && request.resource.data.deleted != true;
    }

    match /{path=**}/messages/{messageId} {
      allow read: if isServicePreview();
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          (isDevAdminAuth()
            && request.resource.data.login == 'badura_admin'
            && request.resource.data.role == 'admin'
            && request.resource.data.accountStatus == 'active')
          || (request.resource.data.role == 'user'
            && request.resource.data.accountStatus == 'pending'
            && request.resource.data.canWrite == false
            && request.resource.data.uid == uid
            && request.resource.data.login is string
            && request.resource.data.firstName is string
            && request.resource.data.lastName is string
            && request.resource.data.fullName is string
            && request.resource.data.nickname is string
            && request.resource.data.displayName is string
            && request.resource.data.serviceType is string
            && request.resource.data.county is string
            && request.resource.data.voivodeship is string)
        );

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || isActive();

      allow update: if isAdmin()
        || (moderatorCan('approveAccounts')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountStatus',
            'canWrite',
            'blockedWrite',
            'unitType',
            'serviceType',
            'unitName',
            'unitId',
            'voivodeship',
            'county',
            'publicName',
            'updatedAt'
          ]))
        || (moderatorCan('muteUsers')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'muted',
            'mutedUntil',
            'mutedReason',
            'mutedBy',
            'blockedWrite'
          ]))
        || (isDevAdminAuth()
          && request.auth.uid == uid
          && request.resource.data.login == 'badura_admin'
          && request.resource.data.role == 'admin'
          && request.resource.data.accountStatus == 'active')
        || (isActive()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nickname',
            'firstName',
            'lastName',
            'fullName',
            'displayName',
            'phoneNumber',
            'description',
            'avatarUrl',
            'publicName',
            'presenceStatus',
            'lastSeenAt',
            'fcmTokens',
            'mustChangePassword',
            'mustSetPassword',
            'firstLoginTutorialCompleted',
            'settings',
            'settingsUpdatedAt',
            'updatedAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'firstName',
            'lastName',
            'fullName',
            'displayName'
          ]) || hasMissingFullName())
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.unitId == resource.data.unitId
          && request.resource.data.unitName == resource.data.unitName);

      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow get: if (chatExists(chatId) && canAccessChatData(resource.data))
        || (!chatExists(chatId) && isActive());
      allow list: if isActive();
      allow create: if canCreateChat();
      allow update: if (isAdmin() && chatType(resource.data) == 'main')
        || (canWrite() && !isServicePreviewUnitChat(chatId) && canAccessChat(chatId, resource.data) && chatMessageMetadataKeysOnly())
        || (isActive() && !isServicePreviewUnitChat(chatId) && canAccessChat(chatId, resource.data) && chatReadKeysOnly())
        || canUpdateChatSettings()
        || canUpdateGroupMembers()
        || canUpdatePrivateChatMembersOrVisibility()
        || canUpdateOwnChatVisibility()
        || canArchiveGroup();
      allow delete: if isAdmin() && chatType(resource.data) == 'main';

      match /messages/{messageId} {
        allow read: if canReadMessagesInChat(chatId);
        allow create: if validMessageCreate(chatId);
        allow update: if (isAdmin()
            && chatExists(chatId)
            && !isServicePreviewUnitChat(chatId)
            && canAccessChat(chatId, chatData(chatId)))
          || (chatExists(chatId)
            && !isServicePreviewUnitChat(chatId)
            && canAccessChat(chatId, chatData(chatId))
            && (isOwnMessageRecall() || isModeratorRecall() || isOwnMessageEdit() || isReactionOrReportUpdate()));
        allow delete: if !isServicePreviewUnitChat(chatId)
          && (
            (isAdmin()
              && chatExists(chatId)
              && canAccessChat(chatId, chatData(chatId)))
            || canDeleteGroupMessage(chatId)
          );
      }

      match /typing/{uid} {
        allow read: if chatExists(chatId) && canAccessChat(chatId, chatData(chatId));
        allow write: if signedIn()
          && request.auth.uid == uid
          && canWrite()
          && chatExists(chatId)
          && !isServicePreviewUnitChat(chatId)
          && canAccessChat(chatId, chatData(chatId));
      }

      match /reads/{uid} {
        allow read: if signedIn()
          && request.auth.uid == uid
          && chatExists(chatId)
          && canAccessChat(chatId, chatData(chatId));
        allow write: if signedIn()
          && request.auth.uid == uid
          && isActive()
          && chatExists(chatId)
          && !isServicePreviewUnitChat(chatId)
          && canAccessChat(chatId, chatData(chatId));
      }
    }

    match /invite_codes/{code} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.active == true
          && resource.data.usedCount < resource.data.maxUses
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedCount'
          ])
          && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    match /units/{unitId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActive()
        && (resource.data.recipientId == request.auth.uid
          || resource.data.recipientId == 'all');
      allow update: if (isActive()
          && resource.data.recipientId == request.auth.uid)
        || isAdmin()
        || (isActive()
          && resource.data.createdBy == request.auth.uid
          && resource.data.type == 'adminAnnouncement');
      allow create: if isAdmin()
        || (isActive()
          && request.resource.data.recipientId == 'all'
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.type == 'adminAnnouncement'
          && request.resource.data.data is map
          && request.resource.data.data.eventId is string);
      allow delete: if isAdmin()
        || (isActive()
          && resource.data.createdBy == request.auth.uid
          && resource.data.type == 'adminAnnouncement');
    }

    match /events/{eventId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.place is string
        && request.resource.data.dateTime is timestamp;
      allow update: if moderatorCan('manageEvents')
        || (isActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'interestedIds',
            'attendeeIds',
            'updatedAt'
          ]))
        || (isActive()
          && resource.data.organizerId == request.auth.uid);
      allow delete: if isAdmin()
        || moderatorCan('manageEvents')
        || (isActive() && resource.data.organizerId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow read, update, delete: if isModerator();
      allow create: if isActive()
        && request.resource.data.reporterId == request.auth.uid;
    }

    match /moderation_logs/{logId} {
      allow read: if isAdmin() || moderatorCan('accessLogs');
      allow create: if isModerator()
        || (isActive()
          && request.resource.data.performedBy == request.auth.uid
          && (request.resource.data.action == 'event_updated'
            || request.resource.data.action == 'event_deleted'));
      allow update, delete: if isAdmin();
    }

    match /service_sessions/{uid} {
      allow read, create, update, delete: if isAdmin()
        && request.auth.uid == uid
        && request.auth.token.keys().hasAny(['email'])
        && request.auth.token.email == 'badura_admin@tarnobrzeg112.local';
    }

    match /password_reset_requests/{requestId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /pinned_messages/{pinId} {
      allow read: if isActive();
      allow create, update, delete: if isModerator();
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (settingId == 'superAdminCreated'
          && isDevAdminAuth()
          && request.resource.data.login == 'badura_admin')
        || (settingId == 'adminBootstrap_badura_admin'
          && isDevAdminAuth()
          && request.resource.data.login == 'badura_admin');
      allow update, delete: if isAdmin();

      match /users/{uid} {
        allow read: if isActive();
        allow write: if canWrite() && request.auth.uid == uid;
      }
    }
  }
}
